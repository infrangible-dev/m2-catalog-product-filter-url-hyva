{
    "name": "infrangible/m2-catalog-product-filter-url-hyva",
    "description": "Makes Catalog Product Filter Url work in stores with the Hyvä theme: configurable product options are preselected from the filters chosen in the listing.",
    "type": "magento2-module",
    "version": "1.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Hyvä",
        "Layered navigation",
        "Product options",
        "Hyvä support for Catalog Product Filter Url",
        "preselect variant from filter for Hyvä"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-filter-url-hyva",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-catalog-product-filter-url": "~1.0.0",
        "hyva-themes/magento2-compat-module-fallback": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductFilterUrlHyva\\": "src"
        }
    }
}
